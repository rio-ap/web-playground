{
  "name": "trazire-mart",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright test --reporter=html",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:all": "npm test && npm run test:e2e && npm run test:a11y",
    "build:reports": "npm run coverage && npm run test:e2e:report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.12",
    "tailwindcss": "^4.1.4",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "nanoid": "^3.3.20",
    "postcss": "^8.5.31",
    "source-map-js": "^1.2.2"
  }
}
